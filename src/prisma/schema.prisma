generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

enum AssetType {
  stock
  crypto
}

enum AlertCondition {
  above
  below
}

model User {
  id        Int         @id @default(autoincrement())
  email     String      @unique
  password  String
  role      Role        @default(user)
  createdAt DateTime    @default(now())
  portfolio Portfolio[]
  alerts    Alert[]

  @@map("users")
}

model Asset {
  id        Int         @id @default(autoincrement())
  symbol    String      @unique
  name      String
  type      AssetType
  price     Decimal     @db.Decimal(18, 8)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  portfolio Portfolio[]
  alerts    Alert[]

  @@map("assets")
}

model Portfolio {
  id        Int      @id @default(autoincrement())
  userId    Int
  assetId   Int
  quantity  Decimal  @db.Decimal(18, 8)
  buyPrice  Decimal  @db.Decimal(18, 8)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([assetId])
  @@map("portfolio")
}

model Alert {
  id            Int            @id @default(autoincrement())
  userId        Int
  assetId       Int
  targetPrice   Decimal        @db.Decimal(18, 8)
  condition     AlertCondition
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset         Asset          @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([assetId])
  @@map("alerts")
}
